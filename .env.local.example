# Local secrets for ./aegis.sh
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; this example is not, so never put a real key in THIS file.
#
#   cp .env.local.example .env.local
#   # edit .env.local
#   ./aegis.sh restart
#
# Anything already exported in your shell wins over this file, so a one-off
# `OPENAI_API_KEY=sk-... ./aegis.sh start` still overrides it.

# Conformance scoring and simulator prompt parsing.
#
# WITHOUT this key AEGIS still runs and still decides: the engine serves
# recorded scores from the frozen fixture and falls back to the deterministic
# scorer for anything novel, with no network call. Setting it upgrades both
# the conformance score and the simulator's prompt parsing to the model.
#
# Costs real money, one call per uncached decision. Seeding 25,000 actions
# with a live key is a large bill -- seed offline, then set this for demos.
OPENAI_API_KEY=

# Which model scores conformance. Default: gpt-4.1-mini
# AEGIS_SCORER_MODEL=gpt-4.1-mini

# Seconds before a scorer call is abandoned and the deterministic fallback
# takes over. Default: 4.0
# AEGIS_SCORER_TIMEOUT=4.0

# Force the scorer mode instead of inferring it from the key.
#   auto    live when OPENAI_API_KEY is set, replay otherwise (default)
#   live    always call the model
#   replay  always serve the recorded fixture
#   off     no scoring at all -- exercises the true fail-closed path
# AEGIS_SCORER_MODE=auto

# Signing secret for API tokens. The development default is fine locally and
# unacceptable anywhere else.
# JWT_SECRET=
